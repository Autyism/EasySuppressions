{
  "schemaVersion": 1,
  "id": "easysuppressions",
  "version": "${version}",
  "name": "Autyism's Easy Suppressions",
  "description": "Portal cutting and light suppression for technical survival servers on 1.21.11, without real update suppression: a portal cutter block keeps nether portal blocks in its zone from breaking, and a light suppressor block makes every light query in its zone return a locked or fixed value. Required on both server and client.",
  "authors": ["Autyism"],
  "contact": {
    "homepage": "https://github.com/Autyism/EasySuppressions",
    "sources": "https://github.com/Autyism/EasySuppressions",
    "issues": "https://github.com/Autyism/EasySuppressions/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/easysuppressions/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.autyism.easysuppressions.EasySuppressions"],
    "client": ["io.github.autyism.easysuppressions.client.EasySuppressionsClient"],
    "modmenu": ["io.github.autyism.easysuppressions.client.screen.ModMenuIntegration"]
  },
  "mixins": [
    "easysuppressions.mixins.json",
    {
      "config": "easysuppressions.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
